{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "group-study-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "Db",
      "database_name": "groupsstudydb",
      "database_id": "groupsstudydb"
    }
  ]
}
